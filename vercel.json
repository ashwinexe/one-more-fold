{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/",
      "dest": "/exact.html"
    },
    {
      "src": "/v/iphone-duo/a/built/scripts/overview/main.built.js",
      "dest": "/apple-main.js"
    },
    {
      "src": "/(metrics|api-www)(.*)",
      "status": 204
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "https://www.apple.com/$1"
    }
  ]
}
